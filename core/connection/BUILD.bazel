load("@rules_go//go:def.bzl", "go_library", "go_test")
exports_files(["lab-image.txt", "hovel-module.yaml", "survey_ubuntu.sh"])
go_library(
    name = "connection",
    embedsrcs = ["hovel-module.yaml", "survey_ubuntu.sh"],
    srcs = ["activity.go", "capabilities.go", "audit.go", "module.go", "connection_linux.go", "commands.go", "profiles.go", "prompt_linux.go", "ssh_config.go", "manager.go", "sessions_linux.go", "session_control_linux.go", "forward.go", "proxy.go", "files.go", "remote_files.go", "downloads.go", "runs.go", "scripts.go", "survey.go", "chains.go"],
    importpath = "github.com/Bochner/burrow/core/connection",
    visibility = ["//visibility:public"],
    deps = ["@com_github_charmbracelet_ultraviolet//:ultraviolet", "@com_github_charmbracelet_x_ansi//:ansi", "@com_github_charmbracelet_x_vt//:vt", "//core/launch", "//core/reports", "@hovel_sdk//:hovel", "@org_golang_x_sys//unix", "@com_github_pkg_sftp//:sftp"],
)

go_test(
    name = "forward_control_test",
    srcs = ["forward_control_test.go"],
    embed = [":connection"],
)

# Instrument the embedded production parser, not just the fuzz callback.
go_test(
    name = "command_fuzz_test",
    tags = ["external"],
    size = "small",
    srcs = ["commands_fuzz_test.go"],
    embed = [":connection"],
    gc_goopts = ["-d=libfuzzer"],
    args = ["-test.fuzz=FuzzCommandLine", "-test.fuzztime=10s", "-test.fuzzminimizetime=1s", "-test.parallel=1", "-test.timeout=30s"],
    data = glob(["testdata/fuzz/FuzzCommandLine/*"], allow_empty = True),
)

filegroup(
    name = "format_sources",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
