load("@rules_go//go:def.bzl", "go_binary", "go_test")
load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

py_binary(
    name = "lab",
    srcs = ["lab.py"],
    args = ["$(location :burrow-transport-prototype)"],
    data = [":burrow-transport-prototype"],
    legacy_create_init = 0,
)

_PROOF_SOURCES = ["main.go", "ownership.go", "script_boundary.go", "retained_script.go", "direct_script.go", "tunnel_boundary.go"]
_PROOF_DEPS = ["@hovel_sdk//:hovel", "@org_golang_x_crypto//ssh", "@com_github_pkg_sftp//:sftp"]

go_binary(
    name = "burrow-transport-prototype",
    srcs = _PROOF_SOURCES,
    embedsrcs = ["script_fixture.py"],
    deps = _PROOF_DEPS,
)

pkg_tar(
    name = "package",
    srcs = [":burrow-transport-prototype", "hovel-module.yaml", "@hovel_sdk//:LICENSE"],
    extension = "tgz",
    mode = "0755",
)

py_binary(
    name = "check",
    srcs = ["check.py"],
    args = ["$(location :burrow-transport-prototype)", "$(location :package)", "$(location @hovel_linux_wheel//file)", "$(location local_terminal.py)"],
    data = [":burrow-transport-prototype", ":package", "@hovel_linux_wheel//file", "local_terminal.py"],
    legacy_create_init = 0,
)

go_test(
    name = "direct_script_test",
    srcs = _PROOF_SOURCES + ["direct_script_test.go"],
    embedsrcs = ["script_fixture.py"],
    deps = _PROOF_DEPS,
)
