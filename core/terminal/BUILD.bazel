load("@rules_go//go:def.bzl", "go_library", "go_test")
go_library(
    name = "terminal",
    srcs = ["host_linux.go", "shared_linux.go"],
    importpath = "github.com/Bochner/burrow/core/terminal",
    visibility = ["//visibility:public"],
    deps = ["//core/connection", "//core/launch", "@com_github_charmbracelet_ultraviolet//:ultraviolet", "@com_github_charmbracelet_x_ansi//:ansi", "@com_github_charmbracelet_x_vt//:vt", "@org_golang_x_sys//unix"],
)
go_test(
    name = "host_test",
    srcs = ["host_test.go", "shared_test.go"],
    embed = [":terminal"],
    deps = ["@com_github_charmbracelet_ultraviolet//:ultraviolet", "@org_golang_x_sys//unix"],
)

# Real PTY output drain, input/resize, snapshot, scrollback and close/cancel.
# Separate from preflight's repeated setup/terminal Python scenarios.
go_test(
    name = "host_race_test",
    srcs = ["host_test.go"],
    embed = [":terminal"],
    race = "on",
    deps = ["@com_github_charmbracelet_ultraviolet//:ultraviolet", "@org_golang_x_sys//unix"],
)

filegroup(
    name = "format_sources",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
