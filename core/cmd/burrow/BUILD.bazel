load("@rules_go//go:def.bzl", "go_binary")
load("@rules_python//python:defs.bzl", "py_test")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

py_test(
    name = "connection_test",
    srcs = ["connection_check.py"],
    main = "connection_check.py",
    args = ["$(location :burrow)"],
    data = [":burrow"],
    legacy_create_init = 0,
)
py_test(
    name = "connection_lab",
    srcs = ["connection_lab.py"],
    main = "connection_lab.py",
    args = ["$(location :burrow)", "$(location @hovel_linux_wheel//file)", "$(location //core/connection:lab-image.txt)", "$(location :screen_check)"],
    data = [":burrow", "@hovel_linux_wheel//file", "//core/connection:lab-image.txt", ":screen_check"],
    tags = ["local", "external"],
    size = "large",
    legacy_create_init = 0,
)

go_binary(
    name = "burrow",
    srcs = ["main.go", "tui.go"],
    deps = [
        "//core/launch", "//core/connection", "@hovel_sdk//:hovel",
        "@land_charm_bubbletea_v2//:bubbletea", "@land_charm_bubbles_v2//textinput",
        "@land_charm_bubbles_v2//key", "@land_charm_lipgloss_v2//:lipgloss",
        "@land_charm_lipgloss_v2//table", "@com_github_charmbracelet_x_ansi//:ansi",
        "@com_github_charmbracelet_x_term//:term", "@com_github_charmbracelet_colorprofile//:colorprofile",
    ],
)
pkg_tar(
    name = "package",
    srcs = [":burrow", "hovel-module.yaml", "@hovel_sdk//:LICENSE"],
    extension = "tgz",
    mode = "0755",
)
go_binary(
    name = "screen_check",
    srcs = ["screen_check.go"],
    deps = ["@com_github_charmbracelet_x_vt//:vt"],
    testonly = True,
)
py_test(
    name = "setup_test",
    srcs = ["setup_check.py"],
    main = "setup_check.py",
    args = ["$(location :burrow)", "$(location @hovel_linux_wheel//file)", "$(location :package)", "$(location :screen_check)"],
    data = [":burrow", ":package", ":screen_check", "@hovel_linux_wheel//file"],
    size = "medium",
    tags = ["no-sandbox"],
    legacy_create_init = 0,
)
