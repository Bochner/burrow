load("@rules_python//python:defs.bzl", "py_binary", "py_test")

_WORKFLOWS = glob([".github/workflows/*.yml", ".github/workflows/*.yaml"], allow_empty = True)

py_test(
    name = "workflow_test",
    size = "small",
    srcs = [".github/check_workflows.py"],
    main = ".github/check_workflows.py",
    args = ["$(location @actionlint//:actionlint)"] + ["$(location %s)" % path for path in _WORKFLOWS],
    data = ["@actionlint//:actionlint"] + _WORKFLOWS,
    legacy_create_init = 0,
)

# This target checks the metadata build graph, not document accuracy.
exports_files(["Makefile", "VERSION"])
filegroup(
    name = "research",
    srcs = glob(["docs/**/*.md"]) + [
        "AGENTS.md",
        "CONTEXT.md",
        "README.md",
    ],
)

_SOURCES = ["//core/%s:format_sources" % area for area in [
    "agent", "cmd/burrow", "connection", "launch", "reports", "terminal",
]]
_GOFMT = "@burrow_go_sdk//:bin/gofmt"
_ARGS = ["$(location %s)" % _GOFMT] + ["$(locations %s)" % source for source in _SOURCES]

# Explicit package scope; globs discover new drivers without including prototypes.
_PYTHON_SOURCES = glob([".aspect/*.py", ".github/**/*.py"]) + [
    "//core/cmd/burrow:python_format_sources",
    "//docs/tools/docs:python_format_sources",
    "//agent/tools:python_format_sources",
    "//core/tools/release:python_format_sources",
]
_RUFF = "@ruff//:ruff"
_PYTHON_CONFIG = ".aspect/ruff.toml"
_PYTHON_ARGS = ["$(location %s)" % path for path in [_RUFF, _PYTHON_CONFIG]] + ["$(locations %s)" % source for source in _PYTHON_SOURCES]

py_binary(
    name = "python_format",
    main = ".aspect/python_format.py",
    srcs = [".aspect/python_format.py"],
    args = _PYTHON_ARGS,
    data = [_RUFF, _PYTHON_CONFIG] + _PYTHON_SOURCES,
    legacy_create_init = 0,
)

py_test(
    name = "python_format_test",
    size = "small",
    main = ".aspect/python_format.py",
    srcs = [".aspect/python_format.py"],
    args = _PYTHON_ARGS,
    data = [_RUFF, _PYTHON_CONFIG] + _PYTHON_SOURCES,
    legacy_create_init = 0,
)

py_test(
    name = "python_format_behavior_test",
    size = "small",
    main = ".aspect/python_format_test.py",
    srcs = [".aspect/python_format_test.py", ".aspect/python_format.py"],
    args = ["$(location %s)" % path for path in [_RUFF, _PYTHON_CONFIG]],
    data = [_RUFF, _PYTHON_CONFIG],
    legacy_create_init = 0,
)

py_binary(
    name = "go_format",
    main = ".aspect/go_format.py",
    srcs = [".aspect/go_format.py"],
    args = _ARGS,
    data = [_GOFMT] + _SOURCES,
    legacy_create_init = 0,
)

py_test(
    name = "go_format_test",
    size = "small",
    srcs = [".aspect/go_format.py"],
    main = ".aspect/go_format.py",
    args = _ARGS,
    data = [_GOFMT] + _SOURCES,
    legacy_create_init = 0,
)

py_test(
    name = "go_format_behavior_test",
    main = ".aspect/go_format_test.py",
    size = "small",
    srcs = [".aspect/go_format_test.py", ".aspect/go_format.py"],
    args = ["$(location %s)" % _GOFMT],
    data = [_GOFMT],
    legacy_create_init = 0,
)
