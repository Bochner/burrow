def _impl(ctx: TaskContext) -> int:
    root = ctx.std.env.aspect_root_dir()
    commands = {
        "build": ["run", "--run-in=./bazel-burrow", "//core/tools/release:wheel", "--", "--out-dir", root + "/dist"],
        "check": ["test", "//core/tools/release:wheel_test", "//core/tools/release:release_test"],
        "validate": ["run", "//core/tools/release:release", "--", "validate"] + ctx.args.options,
        "verify-pypi": ["run", "//core/tools/release:release", "--", "verify-pypi"],
    }
    mode = ctx.args.mode[0]
    if mode not in commands:
        print("expected build, check, validate or verify-pypi")
        return 2
    return ctx.std.process.command("aspect").args(commands[mode]).current_dir(root).spawn().wait().code or 0

burrow_release = task(
    args = {
        "mode": args.positional(default = ["build"], minimum = 0, maximum = 1),
        "options": args.trailing_var_args(description = "Validation options: --tag vVERSION --publish true|false."),
    },
    summary = "Build or check the Linux pipx wheel, validate release source, or verify its published PyPI digest. Never uploads.",
    implementation = _impl,
)
