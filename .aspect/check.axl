def _impl(ctx: TaskContext) -> int:
    root = ctx.std.env.aspect_root_dir()
    mode = ctx.args.mode[0]
    if mode not in ["full", "ci"]:
        print("expected full or ci")
        return 2
    commands = [
        ["build", "//:research", "//core/prototype_sdk:package", "//core/prototype_sdk:frontend", "//core/prototype_transport:package", "//core/prototype_agent:burrow"],
        ["test", "//docs/tools/docs:site_test", "//docs/tools/docs:stage_site_test", "//core/prototype_sdk:protocol_test", "//core/prototype_sdk:reuse_test", "//core/prototype_terminal:check"],
    ]
    # The SSH observation fixture requires the exact host binaries in check.py.
    if mode == "full":
        commands.append(["run", "//core/prototype_transport:check"])
        commands.append(["run", "//core/prototype_agent:check"])
    for command in commands:
        status = ctx.std.process.command("aspect").args(command).current_dir(root).spawn().wait()
        if status.code:
            return status.code
    return 0

burrow_check = task(
    args = {"mode": args.positional(default = ["full"], minimum = 0, maximum = 1)},
    summary = "Check metadata, documentation, and the disposable prototypes.",
    implementation = _impl,
)
