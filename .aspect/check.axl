def _impl(ctx: TaskContext) -> int:
    root = ctx.std.env.aspect_root_dir()
    mode = ctx.args.mode[0]
    suite = ctx.args.mode[1] if len(ctx.args.mode) > 1 else "all"
    if mode not in ["full", "ci", "preflight", "verify"]:
        print("expected full, ci, preflight or verify")
        return 2
    if suite not in ["all", "portable", "lifecycle", "files", "reverse", "shell", "chains", "reports", "automation", "follow", "runs", "hovel"] or (mode not in ["preflight", "verify"] and suite != "all"):
        print("optional preflight suite: portable, lifecycle, files, reverse, shell, chains, reports, automation, follow, runs or hovel")
        return 2
    # Discover every declared test; adding a target must not require updating
    # a second, hand-maintained list. Release checks execute rather than cache-hit.
    tests = ["test", "--bazel-flag=--build_tests_only", "--bazel-flag=--cache_test_results=" + ("auto" if mode == "verify" else "no"), "--bazel-flag=--flaky_test_attempts=1", "--bazel-flag=--noruns_per_test_detects_flakes", "--bazel-flag=--runs_per_test=1"]
    filters = ["-manual"]
    tests += ["--bazel-flag=--local_test_jobs=2"]
    if mode in ["preflight", "verify"]:
        if suite in ["all", "portable"]:
            filters += ["-production-coverage"]
        if suite != "all":
            filters += ["hovel-followup" if suite == "hovel" else "-hovel-followup"]
    commands = []
    if suite in ["all", "portable"]:
        commands.append(["build", "//core/cmd/burrow:package", "//:research"])
    if mode == "ci":
        filters += ["-requires-docker"]
    elif suite == "portable":
        filters += ["-acceptance"]
    elif suite not in ["all", "hovel"]:
        filters += ["acceptance-" + suite]
    tests += ["--bazel-flag=--test_tag_filters=" + ",".join(filters)]
    if mode in ["preflight", "verify"]:
        commands.insert(0, ["run", "//docs/tools/docs:report", "--", "begin", "--suite", suite])
        tests += ["--bazel-flag=--build_event_json_file=" + root + "/.report-input/" + suite + "/bep.json"]
    commands.append(tests + ["//..."])
    for command in commands:
        status = ctx.std.process.command("aspect").args(command).current_dir(root).spawn().wait()
        if status.code:
            break
    result = status.code or 0
    if mode in ["preflight", "verify"]:
        collected = ctx.std.process.command("aspect").args(["run", "//docs/tools/docs:report", "--", "collect", "--suite", suite, "--exit-code", str(result)]).current_dir(root).spawn().wait().code or 0
        if result or collected:
            return result or collected
        if suite == "all":
            return ctx.std.process.command("aspect").args(["burrow-report", "coverage"]).current_dir(root).spawn().wait().code or 0
        return 0
    return result

burrow_check = task(
    args = {"mode": args.positional(default = ["full"], minimum = 0, maximum = 2)},
    summary = "Run all checks (full), portable checks (ci), uncached preflight [suite], or routine verify [suite] with deterministic test caching.",
    implementation = _impl,
)
