def _impl(ctx: TaskContext) -> int:
    root = ctx.std.env.aspect_root_dir()
    mode = ctx.args.mode[0]
    if mode not in ["full", "ci"]:
        print("expected full or ci")
        return 2
    commands = [
        ["build", "//core/cmd/burrow:package", "//:research", "//core/prototype_sdk:package", "//core/prototype_sdk:frontend", "//core/prototype_transport:package", "//core/prototype_agent:burrow", "//core/prototype_terminal:terminal", "//core/prototype_manager:burrow", "//core/prototype_manager:baseline"],
        ["test", "//core/cmd/burrow:setup_test", "//core/cmd/burrow:connection_test", "//core/cmd/burrow:profile_test", "//core/cmd/burrow:interaction_test", "//core/launch:online_test", "//core/launch:digest_test", "//core/prototype_transport:direct_script_test", "//core/prototype_agent:check", "//docs/tools/docs:site_test", "//docs/tools/docs:stage_site_test", "//core/prototype_sdk:protocol_test", "//core/prototype_sdk:reuse_test", "//core/prototype_terminal:check", "//core/prototype_terminal:terminal_test", "//core/prototype_terminal:cli_test", "//core/prototype_terminal:vt_test", "//core/prototype_terminal:vt_cli_test"],
    ]
    # Production SSH uses a declared digest-pinned disposable Docker server.
    if mode == "full":
        commands.append(["test", "//core/cmd/burrow:connection_lab", "//core/prototype_manager:check", "//core/prototype_manager:consumer_check"])
    commands[1] += ["//core/terminal:host_test", "//core/cmd/burrow:terminal_test", "//core/connection:forward_control_test"]
    commands[1].append("//core/cmd/burrow:files_test")
    for command in commands:
        status = ctx.std.process.command("aspect").args(command).current_dir(root).spawn().wait()
        if status.code:
            return status.code
    return 0

burrow_check = task(
    args = {"mode": args.positional(default = ["full"], minimum = 0, maximum = 1)},
    summary = "Check production setup, metadata, documentation, and retained proofs.",
    implementation = _impl,
)
