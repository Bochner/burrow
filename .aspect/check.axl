def _impl(ctx: TaskContext) -> int:
    root = ctx.std.env.aspect_root_dir()
    for command in [["build", "//:research"], ["test", "//docs/tools/docs:site_test"]]:
        status = ctx.std.process.command("aspect").args(command).current_dir(root).spawn().wait()
        if status.code:
            return status.code
    return 0

burrow_check = task(
    summary = "Check the repository metadata and documentation book.",
    implementation = _impl,
)
