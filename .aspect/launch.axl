def _impl(ctx: TaskContext) -> int:
    root = ctx.std.env.aspect_root_dir()
    if ctx.args.mode[0] == "clean":
        # Native build-output cleanup, scoped by Bazel to this checkout's output base.
        # Never remove workspace state or retained runtime caches here.
        return ctx.std.process.command("bazel").args(["clean"]).current_dir(root).spawn().wait().code or 0
    commands = {
        "format": ["run", "--run-in=./bazel-burrow", "//:go_format", "--", "--write", root],
        "format-check": ["test", "//:go_format_test"],
        "python-format": ["run", "--run-in=./bazel-burrow", "//:python_format", "--", "--write", root],
        "python-format-check": ["test", "//:python_format_test", "//:python_format_behavior_test"],
        "agent-discovery": ["run", "//agent/tools:discovery"],
        "agent-exercise": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--agent-exercise"] + ctx.args.options,
        "run": ["run", "//core/cmd/burrow:burrow", "--"] + ctx.args.options,
        "check": ["test", "//core/cmd/burrow:setup_test", "//core/cmd/burrow:connection_test", "//core/cmd/burrow:profile_test", "//core/cmd/burrow:interaction_test", "//core/launch:online_test", "//core/launch:digest_test", "//core/launch:audit_test", "//core/terminal:host_test", "//core/cmd/burrow:terminal_test"],
        "ssh-check": ["test", "--bazel-flag=--build_tests_only", "--bazel-flag=--nocache_test_results", "--bazel-flag=--test_tag_filters=acceptance", "//..."],
        "workspace-check": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--workspace-check"],
        "sessions-check": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--sessions-check"],
        "shared-tui-check": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--shared-tui-check"],
        "shell-check": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--shell-check"],
        "files-check": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--files-check"],
        "runs-check": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--runs-check"],
        "automation-check": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--automation-check"],
        "follow-check": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--follow-check"],
        "reports-check": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--reports-check"],
        "chains-check": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--chains-check"],
        "scripts-check": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--scripts-check"],
        "forward-check": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--forward-check"],
        "reverse-check": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--reverse-check"],
        "proxy-check": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--proxy-check"],
        "ssh-smoke": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--smoke"],
        "ssh-latency": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--measure"],
        "shell-latency": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--shell-latency"] + ctx.args.options,
        "file-latency": ["run", "--run-in=./bazel-burrow", "//core/cmd/burrow:connection_lab", "--", "--file-latency"] + ctx.args.options,
        "package": ["build", "//core/cmd/burrow:package"],
    }
    mode = ctx.args.mode[0]
    if mode not in commands:
        print("expected agent-discovery, agent-exercise, run, check, clean, ssh-check, workspace-check, sessions-check, shared-tui-check, shell-check, files-check, runs-check, follow-check, reports-check, chains-check, scripts-check, automation-check, forward-check, reverse-check, proxy-check, ssh-smoke, ssh-latency, shell-latency, file-latency, package, format, format-check, python-format, or python-format-check")
        return 2
    if mode == "check":
        commands[mode] += ["//core/cmd/burrow:agent_test", "//core/cmd/burrow:activity_test"]
        commands[mode] += ["//core/cmd/burrow:workspace_test", "//core/cmd/burrow:capabilities_test", "//core/cmd/burrow:files_test", "//core/cmd/burrow:manager_compatibility_test"]
    return ctx.std.process.command("aspect").args(commands[mode]).current_dir(root).spawn().wait().code or 0

burrow = task(
    args = {
        "mode": args.positional(default = ["check"], minimum = 0, maximum = 1),
        "options": args.trailing_var_args(description = "Burrow options, starting with --workspace PATH."),
    },
    summary = "Run, check, agent-discovery, agent-exercise, clean build outputs, ssh-smoke, ssh-check, workspace-check, sessions-check, shared-tui-check, shell-check, files-check, runs-check, follow-check, reports-check, chains-check, scripts-check, automation-check, forward-check, reverse-check, proxy-check, ssh-latency, shell-latency, file-latency, format, format-check, python-format, python-format-check or package the production Linux frontend.",
    implementation = _impl,
)
