load("@aspect//feature/github_lint_comments.axl", "GithubLintComments")
load("@aspect//feature/github_status_checks.axl", "GithubStatusChecks")
load("@aspect//feature/github_status_comments.axl", "GithubStatusComments")
load("@aspect//private/lib/artifacts.axl", "ArtifactUpload")

def config(ctx: ConfigContext):
    # GitHub jobs and upload-artifact own reporting, as in Hovel a4cbfdf.
    # Optional Aspect integrations must not require extra CI write permissions.
    if ctx.std.env.var("GITHUB_ACTIONS"):
        for feature in [ArtifactUpload, GithubLintComments, GithubStatusChecks, GithubStatusComments]:
            ctx.features[feature].args.enabled = False
    for name in ["build", "test"]:
        ctx.tasks[name].args.repro_flavors = ["aspect"]
    ctx.tasks["run"].args.run_in = "bazel-root"
