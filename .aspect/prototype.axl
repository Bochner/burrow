def _impl(ctx: TaskContext) -> int:
    root = ctx.std.env.aspect_root_dir()
    commands = {
        "manager-latency": ["run", "//core/prototype_manager:latency", "--"] + ctx.args.hovel,
        "manager-check": ["test", "//core/prototype_manager:check"],
        "manager-format": ["run", "@rules_go//go", "--", "fmt", root + "/core/prototype_manager/main.go", root + "/core/prototype_manager/ssh.go", root + "/core/prototype_manager/baseline.go"],
        "deps": ["run", "@rules_go//go", "--", "-C", root + "/core/prototype_sdk", "get", "charm.land/huh/v2@v2.0.3", "charm.land/bubbletea/v2@v2.0.9", "charm.land/bubbles/v2@v2.2.1", "charm.land/lipgloss/v2@v2.0.6", "github.com/pkg/sftp@v1.13.11", "golang.org/x/crypto@v0.57.0", "golang.org/x/sys@v0.48.0", "github.com/charmbracelet/x/vt@v0.0.0-20260906004030-3986e9119cf9", "github.com/charmbracelet/harmonica@v0.2.0"],
        "scripts-check": ["test", "//core/prototype_transport:direct_script_test"],
        "vt-check": ["test", "//core/prototype_terminal:vt_test", "//core/prototype_terminal:vt_cli_test"],
        "terminal": ["run", "//core/prototype_terminal:terminal", "--"] + ctx.args.hovel,
        "terminal-check": ["test", "//core/prototype_terminal:terminal_test", "//core/prototype_terminal:cli_test"],
        "terminal-format": ["run", "@rules_go//go", "--", "fmt", root + "/core/prototype_terminal/app.go", root + "/core/prototype_terminal/batch.go", root + "/core/prototype_terminal/design.go", root + "/core/prototype_terminal/help.go", root + "/core/prototype_terminal/commands.go", root + "/core/prototype_terminal/main.go", root + "/core/prototype_terminal/shell_linux.go", root + "/core/prototype_terminal/terminal_test.go", root + "/core/prototype_terminal/screen_linux.go", root + "/core/prototype_terminal/vt_test.go"],
        "interaction": ["test", "//core/prototype_terminal:check"],
        "agent-discovery": ["run", "//core/prototype_agent:discovery"],
        "agent": ["test", "//core/prototype_agent:check"],
        "agent-install": ["run", "//core/prototype_agent:burrow", "--"] + ctx.args.hovel,
        "transport": ["run", "//core/prototype_transport:check"],
        "lab": ["run", "//core/prototype_transport:lab", "--"] + ctx.args.hovel,
        "live": ["run", "//core/prototype_transport:live", "--"] + ctx.args.hovel,
        "transport-format": ["run", "//core/prototype_transport:burrow-transport-prototype", "--", "format"],
        "reuse": ["test", "//core/prototype_sdk:reuse_test"],
        "setup": ["run", "//core/prototype_sdk:setup"],
        "frontend": ["run", "//core/prototype_sdk:frontend", "--"] + ctx.args.hovel,
        "check": ["test", "//core/prototype_sdk:protocol_test"],
        "package": ["build", "//core/prototype_sdk:package"],
        "integration": ["run", "//core/prototype_sdk:integration", "--"] + ctx.args.hovel,
    }
    mode = ctx.args.mode[0]
    if mode not in commands:
        print("expected manager-check, manager-latency, manager-format, deps, scripts-check, terminal, terminal-check, terminal-format, vt-check, check, package, integration, frontend, interaction, setup, reuse, agent, agent-discovery, agent-install, transport, transport-format, lab, or live")
        return 2
    status = ctx.std.process.command("aspect").args(commands[mode]).current_dir(root).spawn().wait()
    return status.code or 0

burrow_prototype = task(
    args = {
        "mode": args.positional(default = ["check"], minimum = 0, maximum = 1),
        "hovel": args.trailing_var_args(description = "Integration: pinned Hovel executable. Frontend: socket path and session ID."),
    },
    summary = "Check the disposable external SDK proof.",
    implementation = _impl,
)
