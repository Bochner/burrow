def _impl(ctx: TaskContext) -> int:
    root = ctx.std.env.aspect_root_dir()
    commands = {
        "vt-check": ["test", "//core/prototype_terminal:vt_test", "//core/prototype_terminal:vt_cli_test"],
        "terminal": ["run", "//core/prototype_terminal:terminal", "--"] + ctx.args.hovel,
        "terminal-check": ["test", "//core/prototype_terminal:terminal_test", "//core/prototype_terminal:cli_test"],
        "terminal-format": ["run", "@rules_go//go", "--", "fmt", root + "/core/prototype_terminal/commands.go", root + "/core/prototype_terminal/main.go", root + "/core/prototype_terminal/shell_linux.go", root + "/core/prototype_terminal/terminal_test.go", root + "/core/prototype_terminal/screen_linux.go", root + "/core/prototype_terminal/vt_test.go"],
        "interaction": ["test", "//core/prototype_terminal:check"],
        "agent": ["run", "//core/prototype_agent:check"],
        "agent-install": ["run", "//core/prototype_agent:burrow", "--"] + ctx.args.hovel,
        "transport": ["run", "//core/prototype_transport:check"],
        "lab": ["run", "//core/prototype_transport:lab", "--"] + ctx.args.hovel,
        "transport-format": ["run", "//core/prototype_transport:burrow-transport-prototype", "--", "format"],
        "reuse": ["test", "//core/prototype_sdk:reuse_test"],
        "setup": ["run", "//core/prototype_sdk:setup"],
        "frontend": ["run", "//core/prototype_sdk:frontend", "--"] + ctx.args.hovel,
        "check": ["test", "//core/prototype_sdk:protocol_test"],
        "package": ["build", "//core/prototype_sdk:package"],
        "integration": ["run", "//core/prototype_sdk:integration", "--"] + ctx.args.hovel,
    }
    mode = ctx.args.mode[0]
    if mode not in commands:
        print("expected terminal, terminal-check, terminal-format, check, package, integration, frontend, interaction, setup, reuse, agent, agent-install, transport, transport-format, or lab")
        return 2
    status = ctx.std.process.command("aspect").args(commands[mode]).current_dir(root).spawn().wait()
    return status.code or 0

burrow_prototype = task(
    args = {
        "mode": args.positional(default = ["check"], minimum = 0, maximum = 1),
        "hovel": args.trailing_var_args(description = "Integration: pinned Hovel executable. Frontend: socket path and session ID."),
    },
    summary = "Check the disposable external SDK proof.",
    implementation = _impl,
)
