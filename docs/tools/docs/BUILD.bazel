load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//visibility:public"])
exports_files(["parity.json"])

py_binary(
    name = "report",
    srcs = ["report.py"],
    legacy_create_init = 0,
)

py_test(
    name = "report_test",
    size = "small",
    srcs = ["report_test.py"],
    args = ["$(rootpath :report)"],
    data = [":report"],
    legacy_create_init = 0,
)

py_test(
    name = "stage_site_test",
    size = "small",
    legacy_create_init = 0,
    srcs = ["stage_site_test.py"],
    args = ["$(rootpath stage_site.py)"],
    data = ["stage_site.py", "report.py"],
)

py_test(
    name = "site_test",
    size = "small",
    legacy_create_init = 0,
    srcs = ["site_test.py"],
    args = ["$(rootpath //docs/site:astro_site)", "$(rootpath //core/cmd/burrow:burrow)"],
    data = ["//docs/site:astro_site", "//core/cmd/burrow:burrow"],
)

py_binary(
    name = "stage_site",
    legacy_create_init = 0,
    srcs = ["stage_site.py", "report.py"],
    main = "stage_site.py",
    imports = ["."],
    args = ["$(rootpath //docs/site:astro_site)"],
    data = ["//docs/site:astro_site"],
)
