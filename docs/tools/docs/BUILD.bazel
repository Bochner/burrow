load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])
exports_files(["parity.json"])

py_library(
    name = "report_lib",
    srcs = ["report.py", "hovel_testreport.py"],
    imports = ["."],
)

filegroup(
    name = "python_format_sources",
    srcs = glob(["*.py"]),
    visibility = ["//:__pkg__"],
)

py_binary(
    name = "report",
    srcs = ["report.py"],
    deps = [":report_lib"],
    main = "report.py",
    legacy_create_init = 0,
)

py_test(
    name = "report_test",
    # One external CLI check; the remaining evidence cases share the real entry point.
    size = "small",
    srcs = ["report_test.py"],
    deps = [":report_lib"],
    args = ["$(rootpath :report)"],
    data = [":report"],
    legacy_create_init = 0,
)

py_test(
    name = "stage_site_test",
    size = "small",
    legacy_create_init = 0,
    srcs = ["stage_site_test.py"],
    args = ["$(rootpath stage_site.py)"],
    data = ["stage_site.py"],
)

py_test(
    name = "site_test",
    size = "small",
    legacy_create_init = 0,
    srcs = ["site_test.py"],
    args = ["$(rootpath //docs/site:astro_site)", "$(rootpath //core/cmd/burrow:burrow)"],
    data = ["//docs/site:astro_site", "//core/cmd/burrow:burrow"],
)

py_test(
    name = "browser_test",
    size = "medium",
    srcs = ["browser_test.py"],
    args = ["$(rootpath //docs/site:astro_site)"],
    data = ["//docs/site:astro_site"],
    tags = ["manual", "local"],
    legacy_create_init = 0,
)

py_binary(
    name = "stage_site",
    legacy_create_init = 0,
    srcs = ["stage_site.py"],
    main = "stage_site.py",
    imports = ["."],
    args = ["$(rootpath //docs/site:astro_site)"],
    data = ["//docs/site:astro_site"],
)

py_test(
    name = "report_ui_test",
    srcs = ["report_ui_test.py"],
    args = ["$(rootpath //docs/site:public/assets/report.js)", "$(rootpath //docs/site:public/assets/report.css)"],
    data = ["//docs/site:public/assets/report.js", "//docs/site:public/assets/report.css"],
    size = "small",
    legacy_create_init = 0,
)
