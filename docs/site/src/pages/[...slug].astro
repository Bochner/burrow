import DocsLayout from "../layouts/DocsLayout.astro";
import PageShell from "../layouts/PageShell.astro";
import { getPage, pages } from "../lib/catalog";

export function getStaticPaths() {
  return pages
    .filter((page) => page.slug !== "index")
    .map((page) => ({ params: { slug: page.slug }, props: { slug: page.slug } }));
}

const page = getPage(Astro.props.slug);
---

{page.area === "reports" ? <PageShell area="reports" current="Reports" root="../" tag="// test report" title="Test Report - Burrow" stylesheets={["../assets/report.css"]}>
  <main id="main-content" class="content"><Fragment set:html={page.body} /></main>
</PageShell> : <DocsLayout page={page}>
  <Fragment set:html={page.body} />
</DocsLayout>}
