load("@aspect_rules_js//js:defs.bzl", "js_run_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//docs/site:astro/package_json.bzl", astro = "bin")

package(default_visibility = ["//visibility:public"])

exports_files([".npmrc", ".nvmrc", "package.json", "pnpm-lock.yaml"])

npm_link_all_packages()

astro.astro_binary(name = "astro")

filegroup(
    name = "site_sources",
    srcs = glob(["public/**", "src/**"]) + ["astro.config.mjs", "package.json", "tsconfig.json"],
)

js_run_binary(
    name = "astro_site",
    srcs = [":node_modules/astro", ":site_sources"],
    args = ["build"],
    chdir = package_name(),
    env = {"ASTRO_TELEMETRY_DISABLED": "1"},
    out_dirs = ["dist"],
    tool = ":astro",
)
