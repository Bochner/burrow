load("@aspect_rules_js//js:defs.bzl", "js_run_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//docs/site:astro/package_json.bzl", astro = "bin")

package(default_visibility = ["//visibility:public"])

exports_files([".npmrc", ".nvmrc", "package.json", "pnpm-lock.yaml"])

npm_link_all_packages()

astro.astro_binary(name = "astro")

genrule(
    name = "api_inventory",
    outs = ["api-inventory.json"],
    tools = ["//core/cmd/burrow:burrow"],
    cmd = "$(location //core/cmd/burrow:burrow) capabilities > $@",
)

genrule(
    name = "report_default",
    srcs = [":api_inventory", "//docs/tools/docs:parity.json"],
    outs = ["report-default.json"],
    tools = ["//docs/tools/docs:report"],
    cmd = "$(location //docs/tools/docs:report) default --inventory $(location :api_inventory) --parity $(location //docs/tools/docs:parity.json) --output $@",
)

filegroup(
    name = "site_sources",
    srcs = glob(["public/**", "src/**"]) + ["astro.config.mjs", "package.json", "tsconfig.json"],
)

js_run_binary(
    name = "astro_site",
    srcs = [":node_modules/astro", ":site_sources", ":api_inventory", ":report_default"],
    args = ["build"],
    chdir = package_name(),
    env = {"ASTRO_TELEMETRY_DISABLED": "1"},
    out_dirs = ["dist"],
    tool = ":astro",
)
